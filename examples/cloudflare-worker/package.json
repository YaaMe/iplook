{
  "name": "iplook-cloudflare-worker-example",
  "private": true,
  "type": "module",
  "scripts": {
    "table": "iplook build cidr/*.txt --value-from-filename -o src/geo.iplk",
    "dev": "npm run table && wrangler dev",
    "deploy": "npm run table && wrangler deploy"
  },
  "dependencies": {
    "iplook": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260900.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
