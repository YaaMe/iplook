node_modules/
dist/
*.tsbuildinfo

# Built tables. These are artefacts, and a real one may be derived from a
# licensed commercial database — keep them out of the repository by default.
# fixtures/ is the deliberate exception and is committed explicitly.
*.iplk
!fixtures/*.iplk

# The example builds its own table from the CIDR files beside it.
examples/**/src/*.iplk
